# Brewfile — managed by dotfiles (stow homebrew → ~/.Brewfile)
# Install everything: brew bundle --global
# Check what's missing: brew bundle check --global
# Preview unlisted packages: brew bundle cleanup --global

# Curated Homebrew packages and applications.

tap "nikitabobko/tap"
tap "abue-ammar/tinycast", trusted: true
tap "crmne/tap", trusted: { casks: ["fastpotify"] }

# Command-line tools and runtimes
brew "act"
brew "bat"
brew "docker"
brew "eza"
brew "fzf"
brew "gh"
brew "git"
brew "git-delta"
brew "git-filter-repo"
brew "lazygit"
brew "mise"
brew "neovim"
brew "ollama"
brew "ripgrep"
brew "opencode"
brew "openjdk"
brew "pnpm"
brew "podman"
brew "starship"
brew "stow"
brew "tlrc"
brew "tmux"
brew "uv"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-history-substring-search"
brew "zsh-syntax-highlighting"

# macOS applications and fonts
cask "aerospace"
cask "betterdisplay"
cask "chatgpt"
cask "claude"
cask "claude-code@latest"
cask "ente-auth"
cask "fastpotify"
cask "font-jetbrains-mono-nerd-font"
cask "helium-browser"
cask "mac-mouse-fix"
cask "microsoft-edge"
cask "obs"
cask "obsidian"
cask "qbittorrent"
cask "raycast"
cask "shottr"
cask "slack"
cask "spotify"
cask "stats"
cask "stremio"
cask "telegram"
cask "abue-ammar/tinycast/tinycast"
cask "utm"
cask "vlc"
cask "wezterm"
cask "whatsapp"
cask "zed"
